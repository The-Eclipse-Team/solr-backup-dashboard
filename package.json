{
  "name": "solr-backup-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone live dashboard for the solr-backupper report files.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"vite\" \"npm:server\"",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
